# Copia este archivo como .env.local. Los valores están en Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para el servidor: la puerta de las automatizaciones (/api/automatizaciones/leads).
# Nunca con el prefijo NEXT_PUBLIC_ (ese prefijo las mandaría al navegador).
SUPABASE_SECRET_KEY=sb_secret_...
# Llave larga y al azar que comparten el CRM y n8n (la misma del .env de la raíz)
AUTOMATIZACIONES_TOKEN=
# Llave para calcular la huella de la IP de quien envía el formulario público (/cotiza), sin guardar la IP
HUELLA_SECRETA=
