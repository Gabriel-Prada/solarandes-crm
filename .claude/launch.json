{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/crm", "run", "dev"],
      "port": 3000,
      "env": { "NEXT_TELEMETRY_DISABLED": "1" }
    },
    {
      "name": "mcp-inspector",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "@modelcontextprotocol/inspector@2.13.0"],
      "port": 6274,
      "env": { "npm_config_cache": "D:/herramientas/npm-cache", "MCP_AUTO_OPEN_ENABLED": "false" }
    },
    {
      "name": "n8n",
      "runtimeExecutable": "node",
      "runtimeArgs": ["D:/herramientas/n8n/node_modules/n8n/bin/n8n", "start"],
      "port": 5678,
      "env": {
        "N8N_USER_FOLDER": "D:/herramientas/n8n/datos",
        "N8N_PORT": "5678",
        "GENERIC_TIMEZONE": "America/Bogota",
        "TZ": "America/Bogota",
        "N8N_DIAGNOSTICS_ENABLED": "false"
      }
    }
  ]
}
