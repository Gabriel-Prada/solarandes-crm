# Copia este archivo como .env y completa los valores. El .env nunca se sube a GitHub.

# Proyecto de Supabase (públicos: se pueden ver en el navegador)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secretos: solo para scripts del servidor, nunca en el navegador
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=

# Conexión directa a Postgres por el "session pooler" (funciona en redes IPv4)
SUPABASE_DB_HOST=aws-1-REGION.pooler.supabase.com
SUPABASE_DB_USER=postgres.TU-PROYECTO

# n8n local (fase 3). La llave se crea en n8n: Settings → n8n API → Create an API key.
# Sirve para cargar y exportar los flujos desde el repo. Las credenciales (Telegram, Gmail) no van aquí: se guardan dentro de n8n.
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Llave de la puerta /api/automatizaciones del CRM: la comparten n8n y el CRM (apps/crm/.env.local y Vercel).
# Una cadena larga al azar, por ejemplo: .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATIZACIONES_TOKEN=

# Llave de la API de Anthropic (fase 4). Se crea en la consola de Anthropic; solo la usa el servidor del CRM
# (se copia a apps/crm/.env.local y a Vercel como secreto). Nunca en el navegador ni en n8n.
ANTHROPIC_API_KEY=

# Contraseña de los usuarios ficticios del equipo. Si queda vacía, cargar_datos.py la inventa y la guarda aquí.
DEMO_PASSWORD=

# Fase 6: el usuario propio del asistente público en la base (asistente_web). Los llena
# scripts/supabase/clave_asistente.py (genera la contraseña y la guarda aquí sin mostrarla).
ASISTENTE_DB_HOST=
ASISTENTE_DB_USUARIO=
ASISTENTE_DB_CLAVE=
