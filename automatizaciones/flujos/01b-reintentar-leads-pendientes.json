      "id": "0b1c0b00-0000-4000-8000-000000000003",
      "name": "Leer configuración",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "executeOnce": true,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "configuracion"
        },
        "returnAll": true
      }
    },
    {
      "id": "0b1c0b00-0000-4000-8000-000000000004",
      "name": "Preparar reintento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// El lead pendiente, listo para reenviar (la misma clave: si ya había entrado, el CRM dice \"ya procesado\")\nconst pendiente = $('Tomar un pendiente').first().json;\nconst config = Object.fromEntries($('Leer configuración').all().map((i) => [i.json.clave, i.json.valor]));\nif (!config.crm_url) throw new Error('Falta la fila crm_url en la tabla configuracion');\nreturn [{\n  json: {\n    id: pendiente.id,\n    clave: pendiente.clave,\n    intentos: Number(pendiente.intentos ?? 0) + 1,\n    crm_url: config.crm_url.replace(/\\/$/, ''),\n    correo_gerente: config.correo_gerente ?? '',\n    cuerpo: JSON.parse(pendiente.datos),\n  },\n}];"
      }
    },
    {
      "id": "0b1c0b00-0000-4000-8000-000000000005",
      "name": "Reenviar al CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.crm_url }}/api/automatizaciones/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "yLomTkEU93grp2wJ",
          "name": "CRM SolarAndes (automatizaciones)"
        }
      }
    },
    {
      "id": "0b1c0b00-0000-4000-8000-000000000006",
      "name": "¿Entró al CRM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
