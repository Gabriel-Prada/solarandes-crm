            "motivo": "={{ $('Reenviar al CRM').first().json.statusCode ? 'el CRM respondió ' + $('Reenviar al CRM').first().json.statusCode : (m => /ECONNREFUSED|ECONNRESET/.test(m) ? 'el CRM no contesta: está apagado o sin conexión' : /ETIMEDOUT|ESOCKETTIMEDOUT|timeout/i.test(m) ? 'el CRM tardó demasiado en contestar' : /ENOTFOUND|EAI_AGAIN/.test(m) ? 'no se encontró la dirección del CRM' : m)($('Reenviar al CRM').first().json.error?.message ?? 'el CRM no respondió') }}"
          },
          "schema": [
