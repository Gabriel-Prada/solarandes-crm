    },
    {
      "id": "0b1c0b00-0000-4000-8000-000000000008",
      "name": "Datos para los avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "executeOnce": true,
      "position": [
        1540,
        -200
      ],
      "parameters": {
        "jsCode": "// Lo que necesita el subflujo de avisos (01c)\nconst p = $('Preparar reintento').first().json;\nreturn [{ json: { respuesta: $('Reenviar al CRM').first().json.body, cuerpo: p.cuerpo, correo_gerente: p.correo_gerente, crm_url: p.crm_url } }];"
      }
    },
