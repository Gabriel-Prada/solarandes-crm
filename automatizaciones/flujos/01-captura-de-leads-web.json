    {
      "id": "0b1c0001-0000-4000-8000-000000000002",
      "name": "Leer configuración",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
