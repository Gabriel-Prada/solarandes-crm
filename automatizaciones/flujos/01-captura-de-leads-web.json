    {
      "id": "0b1c0001-0000-4000-8000-000000000003",
      "name": "Preparar envío",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Lo que mandó el formulario, más la configuración (dirección del CRM y correo de la gerente)\nconst cuerpo = $('Formulario web').first().json.body ?? {};\nconst config = Object.fromEntries($('Leer configuración').all().map((i) => [i.json.clave, i.json.valor]));\nif (!config.crm_url) throw new Error('Falta la fila crm_url en la tabla configuracion');\n\n// La clave del envío la genera el formulario (un número por cada vez que se abre la página): así un\n// doble clic o un reintento no duplican nada. Si no viene, se usa la de esta ejecución.\nconst idEnvio = typeof cuerpo.id_envio === 'string' && cuerpo.id_envio.trim().length >= 8 ? cuerpo.id_envio.trim() : null;\nconst texto = (v) => (v === undefined || v === null ? '' : String(v).trim());\n\nreturn [{\n  json: {\n    crm_url: config.crm_url.replace(/\\/$/, ''),\n    correo_gerente: config.correo_gerente ?? '',\n    cuerpo: {\n      clave: idEnvio ? `web-${idEnvio}` : `web-ejecucion-${$execution.id}`,\n      canal: 'web',\n      nombre: texto(cuerpo.nombre),\n      empresa: texto(cuerpo.empresa),\n      celular: texto(cuerpo.celular),\n      ciudad: texto(cuerpo.ciudad),\n      correo: texto(cuerpo.correo),\n      consumo: texto(cuerpo.consumo),\n      mensaje: texto(cuerpo.mensaje),\n    },\n  },\n}];"
      }
    },
    {
      "id": "0b1c0001-0000-4000-8000-000000000004",
      "name": "Registrar en el CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.crm_url }}/api/automatizaciones/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "yLomTkEU93grp2wJ",
          "name": "CRM SolarAndes (automatizaciones)"
        }
      }
    },
