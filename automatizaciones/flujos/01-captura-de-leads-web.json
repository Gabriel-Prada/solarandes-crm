        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "clave": "={{ $('Preparar envío').first().json.cuerpo.clave }}",
            "datos": "={{ JSON.stringify($('Preparar envío').first().json.cuerpo) }}",
            "motivo": "={{ $json.statusCode ? 'el CRM respondió ' + $json.statusCode + ': ' + ($json.body?.error ?? '') : (m => /ECONNREFUSED|ECONNRESET/.test(m) ? 'el CRM no contesta: está apagado o sin conexión' : /ETIMEDOUT|ESOCKETTIMEDOUT|timeout/i.test(m) ? 'el CRM tardó demasiado en contestar' : /ENOTFOUND|EAI_AGAIN/.test(m) ? 'no se encontró la dirección del CRM' : m)($json.error?.message ?? 'el CRM no respondió') }}",
            "intentos": 0
          },
          "schema": [
            {
