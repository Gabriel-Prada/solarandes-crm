      ],
      "parameters": {
        "errorMessage": "=El CRM no registró el lead {{ $('Preparar envío').first().json.cuerpo.clave }} ({{ $('Guardar en pendientes').first().json.motivo }}). Quedó en leads_pendientes: el flujo 01b lo reenvía cada 2 minutos."
      }
    },
    {
      "id": "0b1c0001-0000-4000-8000-000000000101",
      "name": "Datos para los avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -200
      ],
      "parameters": {
        "jsCode": "// Lo que necesita el subflujo de avisos (01c)\nreturn [{\n  json: {\n    respuesta: $('Registrar en el CRM').first().json.body,\n    cuerpo: $('Preparar envío').first().json.cuerpo,\n    correo_gerente: $('Preparar envío').first().json.correo_gerente,\n    crm_url: $('Preparar envío').first().json.crm_url,\n  },\n}];"
      }
    },
    {
